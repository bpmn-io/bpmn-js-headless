  "version": "0.2.0",
  "scripts": {
    "all": "run-s lint bundle test",
    "lint": "eslint .",
    "bundle": "rollup -c rollup.config.js --bundleConfigAsCjs",
    "test": "node test/dist/test.js",
    "prepare": "run-s bundle"
